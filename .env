# src/boot/axios.js
# В dev Quasar слушает порт 9000 (см. quasar.config.js); /api проксируется на шлюз.
# VUE_APP_BASE_URL=http://smart.agromelio.ru
VUE_APP_BASE_URL=http://localhost:9000
# Для quasar dev на хосте — шлюз на машине. В Docker см. environment в docker-compose.yml (api-gateway:8080).
VUE_APP_GATEWAY_URL=http://localhost:8080
# URL микрофронта аналитики в браузере (порт 9001 из agro-analytics-frontend/docker-compose). Без этого хост
# показывает только встроенный AnalyticsDashboard.vue — правки в agro-analytics-frontend/src не видны.
VUE_APP_ANALYTICS_MFE_URL=http://localhost:9001
